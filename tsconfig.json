{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["*"],
      "@/app/*": ["app/*"],
      "@/components/*": ["app/components/*"],
      "@/hooks/*": ["app/hooks/*"],
      "@/constants/*": ["app/constants/*"],
      "@/config/*": ["app/config/*"],
      "@/types/*": ["app/types/*"],
      "@/utils/*": ["app/utils/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
